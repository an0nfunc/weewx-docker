{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "platformAutomerge": true,
  "customManagers": [
    {
      "description": "Images the workflow runs while building: binfmt, BuildKit, the SBOM scanner.",
      "customType": "regex",
      "managerFilePatterns": ["/^\\.github/workflows/[^/]+\\.ya?ml$/"],
      "matchStrings": [
        "(?:image[:=] ?|generator=)(?<depName>[a-z0-9./_-]+):(?<currentValue>[A-Za-z0-9._-]+)@(?<currentDigest>sha256:[a-f0-9]{64})"
      ],
      "datasourceTemplate": "docker"
    }
  ],
  "packageRules": [
    {
      "description": "weewx bumps change what the image ships, so they get a manual look.",
      "matchPackageNames": ["weewx"],
      "commitMessagePrefix": "feat:",
      "automerge": false,
      "addLabels": ["needs-review"]
    },
    {
      "description": "Auto-merge patch, digest and pin updates of everything else once CI passes.",
      "matchUpdateTypes": ["patch", "digest", "pin", "pinDigest"],
      "matchPackageNames": ["!weewx"],
      "automerge": true
    },
    {
      "description": "Minor and major bumps are reviewed manually.",
      "matchUpdateTypes": ["minor", "major"],
      "automerge": false,
      "addLabels": ["needs-review"]
    },
    {
      "description": "Some actions and build images run only in the publish job, which pull request CI does not exercise.",
      "matchManagers": ["github-actions", "custom.regex"],
      "commitMessagePrefix": "chore:",
      "minimumReleaseAge": "7 days",
      "automerge": false,
      "addLabels": ["needs-review"]
    },
    {
      "matchPackageNames": ["docker.io/tonistiigi/binfmt"],
      "versioning": "regex:^qemu-v(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)$"
    },
    {
      "matchPackageNames": ["moby/buildkit"],
      "versioning": "regex:^v(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)$"
    }
  ]
}
